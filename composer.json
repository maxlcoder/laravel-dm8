{
    "name": "maxlcoder/laravel-dm8",
    "description": "php_dm dm8",
    "license": "MIT",
    "authors": [
        {
            "name": "Woody",
            "email": "liurenlin77@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "illuminate/database": "^12.0",
        "illuminate/pagination": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "src/helper.php"
        ],
        "psr-4": {
            "LaravelDm8\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelDm8\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "LaravelDm8\\Dm8\\Dm8ServiceProvider",
                "LaravelDm8\\Dm8\\Dm8ValidationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
