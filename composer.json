{
    "name": "maxlcoder/laravel-dm8",
    "description": "php_dm dm8",
    "license": "MIT",
    "authors": [
        {
            "name": "Woody",
            "email": "liurenlin77@gmail.com"
        }
    ],
    "require": {
        "php": "^7.3 || ^8.0",
        "ext-pdo": "*",
        "illuminate/database": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "illuminate/pagination": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "illuminate/support": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "illuminate/validation": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "files": [
            "src/helper.php"
        ],
        "psr-4": {
            "LaravelDm8\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelDm8\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-codex/laravel10-driver": "1.2.x-dev"
        },
        "laravel": {
            "providers": [
                "LaravelDm8\\Dm8\\Dm8ServiceProvider",
                "LaravelDm8\\Dm8\\Dm8ValidationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
